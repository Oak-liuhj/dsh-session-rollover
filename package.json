{
  "name": "@deepseek-ai/dsh-session-rollover",
  "version": "1.1.0",
  "type": "module",
  "description": "会话分卷接续：轮次计数/八段交接/-N 命名/簇索引/只读回溯（契约 v0.2，旁挂不改宿主）",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "client.js",
    "src/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "docs/"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dsh": {
    "manifestVersion": 1,
    "verifiedDsh": "0.2.1-rc.5",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  },
  "dsBot": {
    "min": "0.2.6",
    "verified": "0.2.6"
  }
}
